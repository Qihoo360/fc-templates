{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "应用 Schema",
  "type": "object",
  "definitions": {
    "ExtendType": {
      "allOf": [
        {
          "enum": [
            "secret",
            "array",
            "boolean",
            "integer",
            "null",
            "number",
            "object",
            "string"
          ]
        }
      ]
    },
    "ParameterProperties": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9-_]+$": {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "default": {
                  "description": "默认值"
                },
                "type": {
                  "$ref": "#/definitions/ExtendType"
                },
                "x-cate": {
                  "type": "string",
                  "description": "引用 PropertyDescription 属性"
                },
                "x-label": {
                  "type": "string",
                  "description": "属性标签；相同标签的属性会渲染在一起"
                },
                "x-restype": {
                  "type": "string",
                  "description": "资源类型；",
                  "enum": [
                    "openai",
                    "mysql",
                    "mongo",
                    "postgresql",
                    "milvus",
                    "redis",
                    "polefs",
                    "s3",
                    "elasticsearch",
                    "weaviate"
                  ],
                  "examples": ["redis", "mysql"]
                },
                "x-placeholder": {
                  "type": "string",
                  "description": "占位提示词",
                  "examples": ["请输入密码"]
                },
                "x-hidden": {
                  "type": "boolean",
                  "description": "隐藏属性；是否显示此属性"
                },
                "x-formitem": {
                  "type": "object",
                  "description": "参数输入类型；比如：输入、单选菜单",
                  "properties": {
                    "type": {
                      "enum": ["input", "select"]
                    }
                  },
                  "examples": [{ "type": "input" }, { "type": "select" }]
                }
              }
            },
            {
              "$ref": "http://json-schema.org/draft-07/schema#"
            }
          ]
        }
      }
    },
    "Parameters": {
      "allOf": [
        {
          "properties": {
            "properties": {
              "$ref": "#/definitions/ParameterProperties"
            }
          }
        },
        {
          "$ref": "http://json-schema.org/draft-07/schema#"
        }
      ]
    }
  },
  "properties": {
    "Edition": {
      "type": "string",
      "description": "应用版本",
      "pattern": "^3\\.\\d+\\.\\d+$",
      "const": "3.0.0"
    },
    "Type": {
      "type": "string",
      "description": "应用类型",
      "const": "Project"
    },
    "Name": {
      "type": "string",
      "description": "应用名称"
    },
    "Provider": {
      "type": "array",
      "description": "应用供应商",
      "items": {
        "type": "string",
        "const": "fc"
      }
    },
    "Version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "Description": {
      "type": "string",
      "description": "应用描述信息",
      "examples": ["本应用提供快速搭建部署的能力"]
    },
    "HomePage": {
      "type": "string",
      "format": "uri",
      "description": "应用源码地址",
      "examples": [
        "https://github.com/Qihoo360/fc-templates/applications/artificial-intelligence/supabase"
      ]
    },
    "Organization": {
      "type": "string",
      "examples": ["函数计算 (FC)"]
    },
    "Effective": {
      "type": "string",
      "examples": ["Public"]
    },
    "Tags": {
      "type": "array",
      "description": "应用标签；通过标签进行检索",
      "items": {
        "type": "string",
        "enum": ["AI", "Custom Runtime"]
      },
      "examples": ["AI", "Custom Runtime"],
      "minItems": 1
    },
    "Category": {
      "type": "string",
      "description": "应用所属类型；用于分类展示",
      "examples": ["开发平台"]
    },
    "ResourceSpecs": {
      "type": "array",
      "description": "应用资源规格；用于应用部署时选择资源规格",
      "items": {
        "type": "string",
        "enum": ["micro", "light", "shared", "dedicated"]
      },
      "examples": ["micro", "light", "shared", "dedicated"],
      "minItems": 1
    },
    "AccessControl": {
      "type": "object",
      "title": "访问控制",
      "description": "最小权限 Scope、角色定义、API 鉴权策略集合，支持策略优先级匹配规则",
      "additionalProperties": false,
      "properties": {
        "Scopes": {
          "type": "array",
          "title": "最小权限单元集合",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name"],
            "properties": {
              "id": {
                "type": "string",
                "title": "Scope 唯一标识",
                "description": "权限标识符，格式规范：xxx:yyy:zzz，支持通配符 *；仅允许小写字母、数字、下划线、中划线、冒号与星号"
              },
              "name": {
                "type": "string",
                "title": "权限名称"
              },
              "description": {
                "type": "string",
                "title": "权限描述"
              }
            }
          }
        },
        "Roles": {
          "type": "array",
          "title": "角色定义，Scope 组合封装",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "scopes"],
            "properties": {
              "id": {
                "type": "string",
                "title": "角色唯一 ID"
              },
              "name": {
                "type": "string",
                "title": "角色名称"
              },
              "description": {
                "type": "string",
                "title": "角色描述"
              },
              "scopes": {
                "type": "array",
                "title": "绑定 Scope 列表",
                "items": {
                  "type": "string",
                  "title": "Scope ID",
                  "description": "权限标识符，格式规范：xxx:yyy:zzz，支持通配符 *"
                }
              }
            }
          }
        },
        "RoutePolicies": {
          "type": "array",
          "title": "API 路由访问策略",
          "description": "运行时匹配策略：\n1. priority：数值越小优先级越高；请求匹配多条策略时，按优先级升序遍历\n2. 候选筛选：同时匹配请求 Http Method + Path 路由模板才纳入候选策略\n3. 鉴权判定：按优先级顺序校验用户是否拥有 policy 绑定 scope；命中第一条具备权限策略即放行\n4. 兜底逻辑：无匹配策略 / 匹配策略但不具备对应 scope → 拒绝访问",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "priority", "methods", "paths", "scope"],
            "properties": {
              "id": {
                "type": "string",
                "title": "策略唯一 ID"
              },
              "priority": {
                "type": "integer",
                "title": "匹配优先级",
                "description": "数值越小优先级越高；多条策略匹配请求时，按优先级升序校验"
              },
              "methods": {
                "type": "array",
                "title": "HTTP 请求方法",
                "items": {
                  "type": "string",
                  "enum": [
                    "GET",
                    "HEAD",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE",
                    "OPTIONS"
                  ]
                }
              },
              "paths": {
                "type": "array",
                "title": "路由模板列表，支持 {param} 路径变量",
                "items": {
                  "type": "string"
                }
              },
              "scope": {
                "type": "string",
                "title": "绑定的权限 Scope ID",
                "description": "权限标识符，格式规范：xxx:yyy:zzz，支持通配符 *"
              },
              "description": {
                "type": "string",
                "title": "策略说明"
              }
            }
          }
        }
      }
    },
    "Parameters": {
      "type": "object",
      "description": "应用参数；设计应用部署所需要的参数",
      "$ref": "#/definitions/Parameters"
    },
    "PropertyDescription": {
      "type": "object",
      "description": "应用参数描述；当声明的参数具有相关性时，可以在参数中加入 x-cate 属性，配置此属性的参数将会以组的方式渲染。",
      "patternProperties": {
        "^[a-zA-Z0-9-_]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title"],
          "properties": {
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "Edition",
    "Type",
    "Name",
    "Provider",
    "Version",
    "Organization",
    "Effective",
    "Tags",
    "Category",
    "Parameters",
    "PropertyDescription"
  ]
}
